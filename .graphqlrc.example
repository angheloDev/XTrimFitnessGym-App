# Example GraphQL Code Generator configuration
# 
# Option 1: Fetch schema from running API server (recommended for development)
# Make sure your API server is running, then run: npm run generate
#
# Option 2: Use schema files from API repository
# If the API repo is in a sibling directory, update codegen.ts:
# schema: ['../XTrimFitGym-Api/src/graphql/**/*.graphql']
#
# Option 3: Use a local schema file
# Export your schema from the API and save it as schema.graphql, then:
# schema: ['./schema.graphql']


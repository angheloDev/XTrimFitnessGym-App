{
	"expo": {
		"name": "XTrimFitGym",
		"slug": "XTrimFitGym",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/logos/XTFG_logo.PNG",
		"scheme": "xtrimfitnessgymapp",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"infoPlist": {
				"NSAppTransportSecurity": {
					"NSAllowsArbitraryLoads": true,
					"NSExceptionDomains": {
						"localhost": {
							"NSExceptionAllowsInsecureHTTPLoads": true
						}
						// "192.168.0.106": {
						// 	"NSExceptionAllowsInsecureHTTPLoads": true,
						// 	"NSIncludesSubdomains": true
						// }
					}
				}
			}
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#13161f",
				"foregroundImage": "./assets/logos/XTFG_logo.PNG",
				"backgroundImage": "./assets/logos/XTFG_logo.PNG",
				"monochromeImage": "./assets/logos/XTFG_logo.PNG"
			},
			"edgeToEdgeEnabled": true,
			"predictiveBackGestureEnabled": false,
			"usesCleartextTraffic": true
		},
		"web": {
			"output": "static",
			"favicon": "./assets/logos/XTFG_logo.PNG",
			"bundler": "metro"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/logos/XTFG_logo.PNG",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#13161f",
					"dark": {
						"backgroundColor": "#13161f"
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"apiUrl": "https://xtrimfitgym-api.onrender.com/graphql",
			"exerciseDbApiKey": "64b5510c2bmsh289da1855afde6dp104548jsn10ffb1b0c145"
		}
	}
}
